{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "site",
      "runtimeExecutable": "/bin/zsh",
      "runtimeArgs": ["-c", "export PATH=$HOME/.local/node/bin:$PATH && npm run dev -- --port 3000"],
      "port": 3000
    },
    {
      "name": "site-windows",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "--", "--port", "3000"],
      "port": 3000
    }
  ]
}
